rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: caller has isSuperAdmin == true en su doc de users.
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // USERS: lectura para autenticados. Create sólo self (bloquea auto-promoción a
    // admin/superAdmin). Update para dueño sin tocar role/isSuperAdmin, o para admin
    // (mantiene el flujo de edición desde AdminUserDetails). Delete sólo admin.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'professional')
        && (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false);
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && !('role' in request.resource.data.diff(resource.data).affectedKeys())
          && !('isSuperAdmin' in request.resource.data.diff(resource.data).affectedKeys()))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // PROJECTS: Allow Read Auth, Write Admin (Relaxed for now if needed, but keeping Admin for write is safer, let's stick to Auth for Read)
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Relaxed for Demo/Fix
      
      // PROJECT LOGS (Bitácora)
      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // EXPENSES: Allow All Auth (Verification)
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // ALLOCATIONS
    match /allocations/{allocationId} {
        allow read, write: if request.auth != null;
    }

    // INVOICES: escrituras normales para autenticados; los DELETE requieren super admin
    // (protege el "Reset Facturación").
    match /invoices/{invoiceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }

    // REPORTS: Allow All Auth
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /apuntes/{apunteId} {
        allow read, write: if request.auth != null;
      }
    }

    // CLIENTS: Allow All Auth (Fixing the reported error)
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    // BALANCE ADJUSTMENTS: Allow All Auth
    match /balance_adjustments/{adjustmentId} {
      allow read, write: if request.auth != null;
    }

    // BANK MOVEMENTS & STATEMENTS: lectura/escritura para autenticados; los DELETE
    // requieren super admin (protege el "Reset Facturación").
    match /bank_movements/{movementId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }
    match /bank_statements/{statementId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }

    // AUDIT LOGS: Allow All Auth
    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // CALENDAR EVENTS: All authenticated users can read. Admins can write freely.
    // Professionals can update events where their UID is in the ingenieros array.
    match /calendar_events/{eventId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null;
    }

    // TASKS: All authenticated users can read. All authenticated users can write.
    // (Role enforcement is handled at the application layer)
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // RESOURCES: Equipment and vehicle registry
    match /resources/{resourceId} {
      allow read, write: if request.auth != null;
    }

    // NOTIFICATIONS: Users can read/update their own; any auth user can create
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}